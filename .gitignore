# Ignore Python files
*.pyc
*~
*.bak
__pycache__

# Ignore virtualenv
.venv

# Keep database outside repo
*.sqlite3

# Keep secrets outside repo
.env

# Keep statics and uploads outside repo
/public/static
/private

# Keep production data outside repo: pato.sh's database dumps and backups
# (accounts, password hashes, private content) and its server settings
/fixtures/
.pato

# Keep the legacy import data outside repo: family documents and scans,
# personal details and password hashes (import/fixtures/auth_user.json)
/import

# Keep scripts outside repo
/*.sh
# ...except the site's own steps after an update (run by update.sh)
!/.post_update.sh

# allow for custom css's
custom_*.css

# Keep logs outside repo
/logs
/gunicorn
/run

# Experiment with familytreemaker
/familytreemaker

# Keep mac-folders outside repo
.DS_Store

auth.md

# Development
old_*
dev_*
*.old
*.dev
docs/

# Claude: local skills and generated briefings
/.claude
/Claude outputs
