# FMLY3 settings - copy to .env and fill in. Never commit .env.
# Every key: documentation/developer/configuration.md

# Security - a new key per site:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=fmly.example.org
CSRF_TRUSTED_ORIGINS=https://fmly.example.org

# Database - default: db.sqlite3 in the project
DATABASE_URL=sqlite:////data/www/fmly.example.org/db.sqlite3

# Files: nginx in production, after Django checked access (Web hosting: Nginx).
# Leave out while developing: Django sends the files itself.
SENDFILE_BACKEND=django_sendfile.backends.nginx

# Accounts - new accounts wait for approval by staff
CMNSD_REGISTRATION_REQUIRES_APPROVAL=True
REGISTER_DEFAULT_GROUPS=Visitors

# The site
SITE_NAME=FMLY
META_DESCRIPTION=An archive of a family's history, memories, and stories.

# Email
DEFAULT_FROM_EMAIL=noreply@fmly.example.org
REGISTRATION_NOTIFY_EMAIL=

# cmnsd - leave out unless needed
# CMNSD_LOAD_ON_READY=False      # switches off the JavaScript enhancements
# CMNSD_DEBUG_PRETTIFY=True      # readable page source while DEBUG
